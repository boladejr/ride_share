rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles hold personal data (name, email, phone). Only the signed-in
    // owner may read or write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bookings are private to the rider who created them. A signed-in rider can
    // create a booking for themselves and read only their own; bookings are
    // immutable from the client.
    match /bookings/{bookingId} {
      // The rider who owns it, or the driver assigned to it, may read.
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || resource.data.assignedDriverId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      // Two allowed client updates:
      //  (a) a signed-in driver claims an UNassigned booking by stamping
      //      themselves onto the driver fields;
      //  (b) the ASSIGNED driver advances the trip lifecycle (status only).
      allow update: if request.auth != null
                    && (
                      (resource.data.assignedDriverId == null
                       && request.resource.data.assignedDriverId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['assignedDriverId', 'assignedDriverName']))
                      ||
                      (resource.data.assignedDriverId == request.auth.uid
                       && request.resource.data.assignedDriverId == resource.data.assignedDriverId
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status'])
                       && request.resource.data.status in ['confirmed', 'in_progress', 'completed'])
                    );
      allow delete: if false;
    }

    // Queue of rides with no auto-assigned driver. Any signed-in driver may
    // read open rides and claim one (sets status to claimed for themselves).
    match /pending_assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.status == 'open'
                    && request.resource.data.status == 'claimed'
                    && request.resource.data.claimedByDriverId == request.auth.uid;
      allow delete: if false;
    }

    // Shared seat inventory. Anyone may read availability (needed to browse
    // routes before logging in), but only signed-in riders may reserve seats.
    // Validate the document shape and never allow deletion.
    match /route_seats/{routeId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.resource.data.routeId is string
                            && request.resource.data.takenSeats is list;
      allow delete: if false;
    }

    // Shared driver pool used for cross-device auto-assignment. Each doc id is
    // the driver's id. Any signed-in user may read it (to match drivers) and
    // seed/register pool entries. Assignment updates only the routing fields
    // (current city, busy-until, load) so identity can't be tampered with.
    match /active_drivers/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['name', 'currentCity', 'busyUntil', 'assignedCount', 'createdAt']);
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['currentCity', 'busyUntil', 'assignedCount']);
      allow delete: if false;
    }

    // Trip ratings. A rider rates the driver after a completed trip; the doc id
    // is the booking's doc id (one rating per trip). A rider may write/read only
    // their own rating (1–5), and the rated driver may read ratings about them.
    match /ratings/{ratingId} {
      allow read: if request.auth != null
                  && (resource.data.riderId == request.auth.uid
                      || resource.data.driverId == request.auth.uid);
      allow create, update: if request.auth != null
                    && request.resource.data.riderId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if false;
    }

    // Driver applications: a signed-in user may submit their own application.
    // Applications are reviewed out-of-band, so no client reads/edits.
    match /driver_applications/{appId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
